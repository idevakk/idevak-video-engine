        "additions": "+3",
        "deletions": "-1",
        "diff": [
          {
            "k": "ctx",
            "t": "if (packet_len > MAX_INGRESS_HEADER_SIZE) {"
          },
          {
            "k": "add",
            "t": "    return Status::InvalidHeaderLength;"
          },
          {
            "k": "del",
