{
  "name": "idevak-video-engine",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Fireship-style, high-retention video generation engine for iDevak - Cloud, AI, and DevOps engineering explainers with reactive mascot synchronization.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate": "python engine/validate.py",
    "transcribe": "python engine/transcribe.py",
    "align": "python engine/align.py",
    "align:draft": "python engine/align.py --draft",
    "draft": "python engine/align.py --draft && node engine/build.mjs",
    "build": "node engine/build.mjs",
    "pipeline": "npm run validate && npm run transcribe && npm run align && npm run build",
    "lint": "npx --yes hyperframes@latest lint",
    "check": "npx --yes hyperframes@latest check",
    "preview": "npx --yes hyperframes@latest preview",
    "render": "npx --yes hyperframes@latest render --quality looks --output renders/video.mp4",
    "test": "node --test tests/*.test.mjs",
    "test:py": "python -m unittest tests.test_daytona_video",
    "eval:asr": "python tests/eval_asr/run_benchmark.py --all",
    "eval:asr:deepgram": "python tests/eval_asr/run_benchmark.py --deepgram-optimized",
    "eval:asr:local": "python tests/eval_asr/run_benchmark.py --local-optimized",
    "qa:frames": "node scripts/qa_frames.mjs",
    "qa:sheets": "python scripts/qa_sheets.py",
    "sfx": "python engine/sfx_mixer.py",
    "render:hq": "npx --yes hyperframes@latest render --quality delivery --output renders/video.mp4",
    "render:portrait": "node scripts/render_scene_preview.mjs --from s001 --to s022 --output build/all_scenes_9_16_demo.mp4",
    "render:portrait:draft": "node scripts/render_scene_preview.mjs --from s001 --to s022 --fps 15 --output build/all_scenes_9_16_draft.mp4",
    "prerender": "npm run build",
    "prerender:hq": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "gsap": "3.14.2"
  }
}
